{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "margin-top": 2,
  "margin-left": 2,
  "margin-right": 2,
  "margin-bottom": 0,

  "modules-left": ["custom/launcher", "wlr/workspaces", "cpu", "memory", "custom/gpu"],
  "modules-center": ["wlr/window"],
  "modules-right": ["pulseaudio", "backlight", "custom/weather", "clock", "power-profiles-daemon", "custom/power"],

  "wlr/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": false,
    "sort-by-number": true
  },

  "custom/launcher": {
    "format": "󰣇",
    "on-click": "wofi --show drun",
    "tooltip": false
  },

  "cpu": {
    "format": "{usage}% 󰻠",
    "interval": 2,
    "tooltip": true,
    "tooltip-format": "CPU: {usage}%"
  },

  "memory": {
    "format": "{percentage}% 󰍛",
    "interval": 2,
    "tooltip": true,
    "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
  },

  "custom/gpu": {
    "exec": "gpu-usage-waybar",
    "format": "{} 󰢮",
    "interval": 2,
    "tooltip": true,
    "tooltip-format": "GPU: {}"
  },

  "wlr/window": {
    "format": "{}",
    "max-length": 50,
    "separate-outputs": true
  },

  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "0% 󰝟",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋋",
      "headset": "󰋋",
      "phone": "󰏲",
      "portable": "󰏲",
      "car": "󰄋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "scroll-step": 5,
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%"
  },

  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip": true,
    "tooltip-format": "Brightness: {percent}%"
  },

  "custom/weather": {
    "exec": "curl -s 'https://wttr.in/Gütersloh?format=3'",
    "interval": 600,
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "{}"
  },

  "clock": {
    "format": "{:%a %d.%m.%y %H:%M}",
    "tooltip": true,
    "tooltip-format": "{:%A, %d %B %Y\n%H:%M:%S}"
  },

  "power-profiles-daemon": {
    "format": "{icon}",
    "format-icons": {
      "performance": "󰓅",
      "balanced": "⚖",
      "power-saver": "🔋"
    },
    "tooltip": true,
    "tooltip-format": "Power Profile: {profile}"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip": true,
    "tooltip-format": "Power Menu",
    "on-click": "bash ~/.config/waybar/scripts/power-menu.sh"
  }
}
