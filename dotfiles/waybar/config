{
  "style": "style.css",
  "layer": "top",
  "exclusive": true,
  "position": "top",
  "height": 30,
  "spacing": 0,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,

  "modules-left": [
    "custom/launcher",
    "custom/separator",
    "niri/workspaces",
    "custom/separator",
    "cpu",
    "custom/separator",
    "memory",
  ],
  "modules-center": ["niri/window"],
  "modules-right": [
    "group/tray-expander",
    "pulseaudio",
    "custom/separator",
    "custom/weather",
    "custom/separator",
    "clock",
    "custom/separator",
    "custom/power"
  ],

  "custom/separator": {
    "format": "|",
    "tooltip": false
  },

  "niri/window": {
    "format": "{}",
    "max-length": 100
  },

  "custom/launcher": {
    "format": "▣",
    "on-click": "fuzzel",
    "tooltip": false
  },

  "niri/workspaces": {
    "format": "{}",
    "format-icons": {
      "default": "◯",
      "active": "●"
    },
    "on-click": "activate",
    "all-outputs": false,
    "active-only": false,
    "sort-by-number": true
  },

  "cpu": {
    "interval": 50,
    "format": "CPU {usage}%",
    "tooltip": true,
    "tooltip-format": "CPU: {usage}%"
  },

  "memory": {
    "interval": 50,
    "format": "RAM {percentage}%",
    "tooltip": true,
    "tooltip-format": "Memory: {used:0.1f}GB / {total:0.1f}GB\n({percentage}%)"
  },

  "group/tray-expander": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "children-class": "tray-group-item"
    },
    "modules": "tray"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 12
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-icons": {
      "default": ["", "", ""]
    },
    "format-muted": "0%",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 5%-",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%\nDevice: {desc}"
  },

  "custom/weather": {
    "exec": "curl -s 'wttr.in/Gütersloh?format=%t+%c' | sed 's/+/ /g'",
    "interval": 600,
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "Weather: Gütersloh, Germany",
    "on-click": "xdg-open 'https://wttr.in/Gütersloh'"
  },

  "clock": {
    "format": "{:%a %d.%m.%y %H:%M}",
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#CCCCCC'><b>{}</b></span>",
        "days": "<span color='#CCCCCC'><b>{}</b></span>",
        "weeks": "<span color='#7fc8ff'><b>W{:%V}</b></span>",
        "weekdays": "<span color='#7fc8ff'><b>{}</b></span>",
        "today": "<span color='#FF0000'><b><u>{}</u></b></span>"
      }
    },
    "interval": 1
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": true,
    "tooltip-format": "Power Menu",
    "on-click": "bash /home/slider/nixos/dotfiles/waybar/power-menu.sh"
  }
}
