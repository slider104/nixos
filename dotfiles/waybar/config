{
  "style": "style.css",
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,

  "modules-left": [
    "custom/launcher",
    "custom/separator",
    "niri/workspaces",
    "custom/separator",
    "cpu",
    "custom/separator",
    "memory",
  ],
  "modules-center": ["niri/window"],
  "modules-right": [
    "pulseaudio",
    "custom/separator",
    "backlight",
    "custom/separator",
    "custom/weather",
    "custom/separator",
    "clock",
    "custom/separator",
    "custom/power"
  ],

  "custom/separator": {
    "format": "|",
    "tooltip": false
  },

  "niri/window": {
    "format": "{}",
    "max-length": 100
  },

  "custom/launcher": {
    "format": "▢",
    "on-click": "fuzzel",
    "tooltip": false
  },

  "niri/workspaces": {
    "format": "{}",
    "format-icons": {
      "default": "◯",
      "active": "●"
    },
    "on-click": "activate",
    "all-outputs": false,
    "active-only": false,
    "sort-by-number": true
  },

  "cpu": {
    "interval": 50,
    "format": "CPU {usage}%",
    "tooltip": true,
    "tooltip-format": "CPU: {usage}%"
  },

  "memory": {
    "interval": 50,
    "format": "RAM {percentage}%",
    "tooltip": true,
    "tooltip-format": "Memory: {used:0.1f}GB / {total:0.1f}GB\n({percentage}%)"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-icons": {
      "default": ["", "", ""]
    },
    "format-muted": "0%",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "wpctl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "wpctl set-sink-volume @DEFAULT_SINK@ -5%",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%\nDevice: {desc}"
  },

"backlight": {
  "exec": "xrandr --query | grep ' connected' | cut -d' ' -f1 | xargs -I {} sh -c 'echo {}=$(xrandr --output {} --getbrightness | grep -oP \"(?<=brightness )\d+\.\d+\")' | head -1 | cut -d'=' -f2",
  "format": "{}%",
  "format-icons": {
    "default": ["◢", "◣", "◤", "◥"]
  },
  "on-click": "xrandr --output $(xrandr --query | grep ' connected' | cut -d' ' -f1 | head -1) --brightness 0.5",
  "on-scroll-up": "xrandr --output $(xrandr --query | grep ' connected' | cut -d' ' -f1 | head -1) --brightness +0.1",
  "on-scroll-down": "xrandr --output $(xrandr --query | grep ' connected' | cut -d' ' -f1 | head -1) --brightness -0.1",
},

  "custom/weather": {
    "exec": "curl -s 'wttr.in/Gütersloh?format=%t+%c' | sed 's/+/ /g'",
    "interval": 600,
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "Weather: Gütersloh, Germany\n{exec}",
    "on-click": "xdg-open 'https://wttr.in/Gütersloh'"
  },

  "clock": {
    "format": "{:%a %d.%m.%y %H:%M}",
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1
    },
    "interval": 1
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": true,
    "tooltip-format": "Power Menu",
    "on-click": "bash /home/slider/nixos/dotfiles/waybar/power-menu.sh",
  }
}
