{
  "style": "style.css",
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,

  "modules-left": [
    "custom/launcher",
    "custom/separator",
    "niri/workspaces",
    "custom/separator",
    "cpu",
    "custom/separator",
    "memory",
    "custom/separator",
    "custom/gpu"
  ],
  "modules-center": ["niri/window"],
  "modules-right": [
    "pulseaudio",
    "custom/separator",
    "backlight",
    "custom/separator",
    "custom/weather",
    "custom/separator",
    "clock",
    "custom/separator",
    "custom/power"
  ],

  "custom/separator": {
    "format": "|",
    "tooltip": false
  },

  "niri/window": {
    "format": "{}",
    "max-length": 100
  },

  "custom/launcher": {
    "format": "❄",
    "on-click": "wofi --show drun",
    "tooltip": false
  },

  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "➀",
      "2": "➁",
      "3": "➂",
      "4": "➃",
      "5": "➄",
      "6": "➅",
      "7": "➆",
      "8": "➇",
      "9": "➈",
      "10": "➉"
    },
    "active-format": "{icon}",
    "active-format-icons": {
      "1": "➊",
      "2": "➋",
      "3": "➌",
      "4": "➍",
      "5": "➎",
      "6": "➏",
      "7": "➐",
      "8": "➑",
      "9": "➒",
      "10": "➓"
    },
    "on-click": "activate",
    "all-outputs": false,
    "active-only": false,
    "sort-by-number": true
  },

  "cpu": {
    "interval": 2,
    "format": "CPU {usage}%",
    "tooltip": true,
    "tooltip-format": "CPU: {usage}%"
  },

  "memory": {
    "interval": 2,
    "format": "RAM {percentage}%",
    "tooltip": true,
    "tooltip-format": "Memory: {used:0.1f}GB / {total:0.1f}GB\n({percentage}%)"
  },

  "custom/gpu": {
    "exec": "gpu-usage-waybar",
    "format": "{}%",
    "interval": 2,
    "tooltip": true,
    "tooltip-format": "GPU Usage: {}%"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-icons": {
      "default": ["", "", ""]
    },
    "format-muted": "0%",
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%"
  },

  "backlight": {
    "device": "amd_bl0",
    "format": "{percent}%",
    "on-click": "brightnessctl set 50%",
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip": true,
    "tooltip-format": "Brightness: {percent}%"
  },

  "custom/weather": {
    "exec": "curl -s 'wttr.in/Gütersloh?format=%t+%c' | sed 's/+/ /g'",
    "interval": 600,
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "Weather: Gütersloh, Germany",
    "on-click": "xdg-open 'https://wttr.in/Gütersloh'"
  },

  "clock": {
    "format": "{:%a %d.%m.%y %H:%M}",
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1
    },
    "interval": 1
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": true,
    "tooltip-format": "Click for power menu",
    "on-click": "~/.config/waybar/scripts/power-menu.sh"
  }
}
