{
  "layer": "top",
  "position": "top",
  "height": 30,
  "margin-top": 4,
  "margin-left": 4,
  "margin-right": 4,
  "spacing": 4,
  "modules-left": [
    "custom/launcher",
    "niri/workspaces",
    "custom/separator",
    "cpu",
    "custom/separator",
    "memory",
    "custom/separator",
    "custom/gpu"
  ],
  "modules-center": [
    "niri/window"
  ],
  "modules-right": [
    "custom/power",
    "custom/separator",
    "pulseaudio",
    "custom/separator",
    "backlight",
    "custom/separator",
    "custom/weather",
    "custom/separator",
    "clock"
  ],
  "custom/launcher": {
    "format": "",
    "on-click": "wofi --show drun",
    "tooltip": false
  },
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": ""
    },
    "on-click": "activate"
  },
  "custom/separator": {
    "format": "|",
    "tooltip": false
  },
  "cpu": {
    "format": " {usage}%",
    "interval": 5
  },
  "memory": {
    "format": " {percentage}%",
    "interval": 5
  },
  "custom/gpu": {
    "format": " {}",
    "exec": "gpu-usage-waybar",
    "interval": 5,
    "return-type": "json"
  },
  "niri/window": {
    "format": "{}",
    "max-length": 50,
    "tooltip": false
  },
  "custom/power": {
    "format": "",
    "on-click": "wofi --show run -p 'Power' -d 'Shutdown:shutdown now\\nReboot:reboot'",
    "tooltip-format": "Click for Power Options"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["", ""],
    "on-click": "brightnessctl set 10%+",
    "on-click-right": "brightnessctl set 10%-"
  },
  "custom/weather": {
    "format": " {}",
    "exec": "curl -s 'wttr.in/Gütersloh?format=%t+%c' | sed 's/+/ /g'",
    "interval": 600,
    "tooltip": true
  },
  "clock": {
    "format": "{:%a %d.%m.%y %H:%M}",
    "tooltip": true,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1
    }
  }
}
